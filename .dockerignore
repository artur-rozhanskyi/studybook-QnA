# Version control and editor metadata.
.git
.gitignore
.idea
.vscode
*.swp
*.swo

# Local environment and secrets.
.env
.env.*
!.env.example
config/master.key
config/credentials/*.key

# Runtime files generated outside the image.
log/*
tmp/*
!/log/.keep
!/tmp/.keep
!/tmp/pids/
!/tmp/pids/.keep
!/tmp/cache/
!/tmp/cache/.keep

# Dependency caches are installed inside Docker layers or named volumes.
.bundle
vendor/bundle
node_modules
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.yarn-integrity
npm-debug.log*
yarn-debug.log*
yarn-error.log

# Build outputs should be produced by the image build.
public/assets
public/packs
public/packs-test
app/assets/builds/*
!app/assets/builds/.keep

# Test, coverage, and local storage artifacts.
coverage
.rspec_status
spec/tmp
public/uploads/*
storage/*
!/storage/.keep

# Legacy Sphinx artifacts.
db/sphinx
config/*.sphinx.conf
